<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Medya Konteyneri (Animasyonlar Bu Kapsayıcıya Uygulanır) -->
    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Sol Üst Ayar Butonu -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:alpha="0.25"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_preferences" />

    <!-- Oynatma Sırasında Sağ Alttaki Küçük & Şeffaf Logo -->
    <ImageView
        android:id="@+id/imgCornerLogo"
        android:layout_width="85dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.35"
        android:src="@drawable/logo_interfon" />

    <!-- QR Kod Eşleme & Ayar Paneli -->
    <LinearLayout
        android:id="@+id/qrOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA111111"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANYPAY MENUBOARD"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kumandadan QR Kodu Okutun"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/imgQrCode"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:padding="10dp" />

        <TextView
            android:id="@+id/txtIpAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseQr"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#D32F2F"
            android:text="Oynatmaya Dön (Kapat)"
            android:textColor="#FFFFFF" />

        <!-- Ayar Ekranı Altındaki Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:alpha="0.8"
            android:src="@drawable/logo_interfon" />
    </LinearLayout>

</FrameLayout>
