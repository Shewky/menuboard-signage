<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Video Alanı -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Resim Alanı -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Sol Üst Ayar Butonu -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:alpha="0.25"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_preferences" />

    <!-- Alt Logo (Footer) -->
    <ImageView
        android:id="@+id/imgFooterLogo"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.85"
        android:src="@drawable/logo_interfon" />

    <!-- QR Kod Eşleme Paneli -->
    <LinearLayout
        android:id="@+id/qrOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA111111"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANYPAY MENUBOARD"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kumandadan QR Kodu Okutun"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/imgQrCode"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtIpAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Geri / Oynatmaya Dön Butonu -->
        <Button
            android:id="@+id/btnCloseQr"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#D32F2F"
            android:text="Oynatmaya Dön (Kapat)"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
