<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_card_light"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- ÖNİZLEME GÖRSELİ + TÜR ROZETİ -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="10dp"
        android:background="#F1F5F9">

        <ImageView
            android:id="@+id/imgThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Medya"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/txtTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="2dp"
            android:background="@drawable/bg_badge_rounded"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="RESİM"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- DOSYA ADI & DETAYLAR -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="kampanya.mp4"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tamamı (30sn) | 12.4 MB"
            android:textColor="#475569"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtAnimBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Animasyon: Solma"
            android:textColor="#0284C7"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- AKSİYON İKONLARI (Göz ikonu MainActivity tarafından otomatik eklenir) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Düzenle"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#0284C7" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sil"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#DC2626" />
    </LinearLayout>

</LinearLayout>
