<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Üst Sekmeler -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#212121"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabDevices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:text="📺 Menuboardlar"
            android:textColor="#00E676"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabMedia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:text="🎬 Medya &amp; Ekran"
            android:textColor="#888888"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Durum Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/txtActiveDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Seçili Cihaz Yok"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bağlantı Yok"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 1. SEKME: CİHAZLAR & OTOMATİK TARAMA -->
    <LinearLayout
        android:id="@+id/panelTabDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScanNetwork"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#00897B"
                android:text="🔍 Ağı Tara (Oto-Bul)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0288D1"
                android:text="📷 QR Kod Tara"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtScanNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ağdaki Cihazlar (Modem resetlense bile otomatik güncellenir):"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 2. SEKME: MEDYA YÖNETİMİ & CANLI EKRAN YANSITMA -->
    <LinearLayout
        android:id="@+id/panelTabMedia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Ekran Yansıtma Kontrol Paneli -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8EAF6"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Telefon Ekranını Yansıt:"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleScreenShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#7B1FA2"
                android:text="📱 Ekranı Paylaş"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Medya Ekleme Paneli -->
        <LinearLayout
            android:id="@+id/panelControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Süre (0:tam)"
                    android:inputType="number"
                    android:text="0" />

                <EditText
                    android:id="@+id/edtWaitAfter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="Bekleme (sn)"
                    android:inputType="number"
                    android:text="0" />

                <Spinner
                    android:id="@+id/spinnerAnim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+ Bu Menuboarda Medya Yükle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Oynatma Listesi:"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPlaylist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgFooterLogo"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:src="@drawable/logo_interfon" />

</LinearLayout>
