<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Üst Sekmeler (3 Sekme) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#212121"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabDevices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:text="📺 Cihazlar"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabMedia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:text="🎬 Medya"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabSefim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:text="🍽️ Şefim Menu"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Durum & Sürüm Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEEEEE"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/txtActiveDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Seçili Cihaz Yok"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRemoteVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="v1.14"
            android:textColor="#1976D2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bağlantı Yok"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 1. SEKME: CİHAZLAR -->
    <LinearLayout
        android:id="@+id/panelTabDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScanNetwork"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#00897B"
                android:text="🔍 Ağı Tara"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0288D1"
                android:text="📷 QR Tara"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ağdaki Menuboardlar:"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 2. SEKME: MEDYA & EKRAN YANSITMA -->
    <LinearLayout
        android:id="@+id/panelTabMedia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8EAF6"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Telefon Ekranını Yansıt:"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleScreenShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#7B1FA2"
                android:text="📱 Ekranı Paylaş"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Süre (0:tam)"
                    android:inputType="number"
                    android:text="0" />

                <EditText
                    android:id="@+id/edtWaitAfter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="Bekleme"
                    android:inputType="number"
                    android:text="0" />

                <Spinner
                    android:id="@+id/spinnerAnim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+ Medya Yükle" />

            <ProgressBar
                android:id="@+id/uploadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Oynatma Listesi:"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPlaylist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 3. SEKME: ŞEFİM MENU -->
    <LinearLayout
        android:id="@+id/panelTabSefim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDbConfig"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#455A64"
                android:paddingHorizontal="2dp"
                android:text="⚙️ DB Ayar"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnFetchSefim"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1.1"
                android:backgroundTint="#0288D1"
                android:paddingHorizontal="2dp"
                android:text="🔄 DB'den Çek"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnLoadDemoProducts"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1.2"
                android:backgroundTint="#7B1FA2"
                android:paddingHorizontal="2dp"
                android:text="🧪 Test Menüleri"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Restoran Adı, Üst Bilgi, Alt Bilgi ve Sayfa Süresi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#ECEFF1"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtRestaurantName"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Restoran Adı"
                    android:paddingHorizontal="6dp"
                    android:singleLine="true"
                    android:text="BALIKÇI ŞÜKRÜ"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtMenuPageDuration"
                    android:layout_width="72dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:gravity="center"
                    android:hint="Süre(sn)"
                    android:inputType="number"
                    android:singleLine="true"
                    android:text="12"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtHeaderNote"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Üst Bilgi (Slogan)"
                    android:paddingHorizontal="6dp"
                    android:singleLine="true"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/edtFooterNote"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Alt Bilgi"
                    android:paddingHorizontal="6dp"
                    android:singleLine="true"
                    android:text="Afiyet Olsun • KDV Dahildir"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Seçenek 1, Seçenek 2, Opsiyon Ayrı Göster/Gizle Kutucukları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:background="#E0F2F1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Göster:"
                android:textColor="#00695C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbShowChoice1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="true"
                android:text="Seçenek 1"
                android:textSize="10sp" />

            <CheckBox
                android:id="@+id/cbShowChoice2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="true"
                android:text="Seçenek 2"
                android:textSize="10sp" />

            <CheckBox
                android:id="@+id/cbShowOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="true"
                android:text="Opsiyon"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tema, Font Boyutu ve Kalınlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <Spinner
                android:id="@+id/spinnerSefimTheme"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4" />

            <Spinner
                android:id="@+id/spinnerSefimFontSize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1" />

            <CheckBox
                android:id="@+id/cbSefimBold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:checked="true"
                android:text="Kalın"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Hareketli Animasyon Objesi Seçimi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:background="#FFF3E0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Animasyon:"
                android:textColor="#E65100"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSefimBgObject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSefimProducts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="#1A1A1A"
            android:padding="4dp" />

        <Button
            android:id="@+id/btnPublishSefimMenu"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:backgroundTint="#E65100"
            android:text="📺 Menüyü &amp; Animasyonu Menuboard'da Yayınla"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sabit Alt Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAFAFA"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageView
            android:id="@+id/imgFooterLogo"
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/logo_interfon" />

        <Button
            android:id="@+id/btnSupportCall"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="#00C853"
            android:text="📞 Destek (Ara)"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
